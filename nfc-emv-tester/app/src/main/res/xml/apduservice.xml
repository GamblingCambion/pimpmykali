<?xml version="1.0" encoding="utf-8"?>
<!--
  AID routing table for the emulator.

  We register under category "other" rather than "payment" on purpose: category
  "payment" requires the app to be the user-selected default contactless payment
  app, whereas "other" lets the OS route these AIDs to us directly, which is what
  we want for a test harness.

  AIDs:
    325041592E5359532E4444463031  = "2PAY.SYS.DDF01" (PPSE) — selected first on a tap
    A0000000031010                = Visa-family AID
    A0000000041010                = Mastercard-family AID

  The scheme AIDs only steer which kernel/UI path the terminal exercises; the
  emulated card carries no cardholder data or keys. Add target-specific AIDs here
  as needed for a given engagement.
-->
<host-apdu-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/hce_service_desc"
    android:requireDeviceUnlock="false">

    <aid-group
        android:category="other"
        android:description="@string/aid_group_desc">
        <aid-filter android:name="325041592E5359532E4444463031" />
        <aid-filter android:name="A0000000031010" />
        <aid-filter android:name="A0000000041010" />
    </aid-group>

</host-apdu-service>
